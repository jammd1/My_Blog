### POST request to local server
POST http://localhost:8080/api/posts
Content-Type: application/json

{
  "title": "테스트용 게시글 제목3",
  "content": "테스트용 게시글 내용3"
}

> {%
 client.test("게시글 작성 테스트 성공", function () {
     client.assert(response.status == 201, "201 Created여야 성공임");
 });

 client.global.set("postId", response.body); // postId 1로 전역 설정
 %}
###

### GET Request to local server with id 1
GET http://localhost:8080/api/posts/{{postId}}

> {%
    client.test("게시글 아이디로 조회 테스트 성공", function () {
        client.assert(response.status == 200, "200 OK여야 성공임");
    });
%}
###

