### PUT Request to local server
PUT http://localhost:8080/api/posts/{{postId}}
Content-Type: application/json

{
  "title": "업데이트된 게시글 제목",
  "content": "업데이트된 게시글 내용"
}

> {%
    client.test("게시글 수정 테스트 성공", function () {
        client.assert(response.status == 200, "200 OK여야 성공임");
    });
%}
